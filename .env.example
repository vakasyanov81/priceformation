# Copy to .env and fill in.
ZAPASKA_API_LOGIN=
ZAPASKA_API_PASSWORD=
# ZAPASKA_API_HOST=ka2.sibzapaska.ru:16500

# API Форточек (источник «api» в parse_config/vendors/four_tochki.json).
FOUR_TOCHKI_API_LOGIN=
FOUR_TOCHKI_API_PASSWORD=
# FOUR_TOCHKI_API_HOST=https://api-b2b.4tochki.ru/WCF/ClientService.svc

# API МИМ (токен доступа; выгрузка в file_prices/mim/price.xlsx).
MIM_API_TOKEN=
# MIM_API_HOST=webmim.svrauto.ru
# Категории выгрузки МИМ через «;»: 1 шины, 2 диски, 3 грузовые шины, 4 грузовые диски,
# 5 секретки, 6 крепёж, 7 прочее. По умолчанию 1;3;4.
# MIM_API_TYPES=1;3;4

# Почта для получения прайсов поставщиков (см. parse_config/mail.json).
MAIL_LOGIN=
MAIL_PASSWORD=
